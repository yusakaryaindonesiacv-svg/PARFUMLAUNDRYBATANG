# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Supabase & Pakasir (Ditetapkan di Environment Variables Vercel atau AI Studio Secrets)
# PENTING: Gunakan awalan VITE_ di Vercel/Vite agar dapat diakses oleh browser.
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_PAKASIR_PROJECT_KEY="your-pakasir-project-slug"
VITE_PAKASIR_API_KEY="your-pakasir-api-key"

